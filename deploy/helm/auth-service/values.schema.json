{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auth-service values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "grpcPort": {
          "type": "integer"
        },
        "metricsPort": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "jwksRefreshSeconds": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "jwksFiles": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "issuerRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "ClusterIssuer",
                "Issuer"
              ]
            },
            "group": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "dnsNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "renewBefore": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        },
        "minAvailable": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxReplicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gatewayNamespace": {
          "type": "string"
        },
        "extraIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "confidential": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "runtimeClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "attestation": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "required": [
                "repository",
                "tag"
              ],
              "additionalProperties": false
            },
            "evidenceURL": {
              "type": "string"
            },
            "trustedKey": {
              "type": "string"
            },
            "measurements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxAge": {
              "type": "string"
            },
            "timeout": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
