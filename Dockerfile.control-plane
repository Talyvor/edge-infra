# Multi-stage build for the Go xDS control plane, token issuer, rate-limit
# service, TLS-secrets custodian, shared-DB migrator, and attestation gate.
#
#   docker build --target server     -t edge-control-plane .
#   docker build --target issuer     -t edge-issuer        .
#   docker build --target ratelimit  -t edge-ratelimit     .
#   docker build --target secrets    -t edge-secrets       .
#   docker build --target migrate    -t edge-migrate       .
#   docker build --target attest     -t edge-attest        .

FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder
WORKDIR /app

ARG TARGETOS=linux
ARG TARGETARCH=amd64

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/issuer ./cmd/issuer
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/ratelimit ./cmd/ratelimit
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/secrets ./cmd/secrets
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/migrate ./cmd/migrate
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-w -s" -o /bin/attest ./cmd/attest


FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS server
COPY --from=builder /bin/server /server
USER nonroot:nonroot
EXPOSE 18000 2112
ENTRYPOINT ["/server"]


FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS issuer
COPY --from=builder /bin/issuer /issuer
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/issuer"]


FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS ratelimit
COPY --from=builder /bin/ratelimit /ratelimit
USER nonroot:nonroot
EXPOSE 8082 8083
ENTRYPOINT ["/ratelimit"]


FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS secrets
COPY --from=builder /bin/secrets /secrets
USER nonroot:nonroot
EXPOSE 8082
ENTRYPOINT ["/secrets"]


# Applies both migration sets (control-plane + OSB) to the shared DB. Run as a
# Helm pre-install/pre-upgrade hook Job, or standalone: DATABASE_URL=... /migrate
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS migrate
COPY --from=builder /bin/migrate /migrate
USER nonroot:nonroot
ENTRYPOINT ["/migrate"]


# The confidential-compute attestation gate (B27.34): an init container that
# refuses to let the workload start without a verified report. `attest
# mock-attester` is a stand-in TEE for the kind e2e only.
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS attest
COPY --from=builder /bin/attest /attest
USER nonroot:nonroot
ENTRYPOINT ["/attest"]
